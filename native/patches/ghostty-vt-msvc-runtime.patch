--- a/pkg/highway/build.zig
+++ b/pkg/highway/build.zig
@@ -1,0 +2 @@ const std = @import("std");
+const MsvcRuntime = enum { static, dll };
@@ -5,0 +7 @@ pub fn build(b: *std.Build) !void {
+    const msvc_runtime = b.option(MsvcRuntime, "msvc-runtime", "The MSVC C runtime to compile for: static (/MT) or dll (/MD)") orelse .static;
@@ -115,0 +118,5 @@ pub fn build(b: *std.Build) !void {
+    // `static` is clang's default for msvc, so only `dll` adds a flag.
+    if (target.result.abi == .msvc and msvc_runtime == .dll) {
+        try flags.append(b.allocator, "-fms-runtime-lib=dll");
+    }
