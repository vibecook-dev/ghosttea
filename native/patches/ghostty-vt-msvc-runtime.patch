diff --git a/pkg/highway/build.zig b/pkg/highway/build.zig
index cdf8d7ecb5ebeab54c8edf0605612b9c7f5bf919..31e865a046220c4276be36e9d2c95904a23060c3 100644
--- a/pkg/highway/build.zig
+++ b/pkg/highway/build.zig
@@ -1,0 +2 @@ const std = @import("std");
+const MsvcRuntime = enum { static, dll };
@@ -5,0 +7 @@ pub fn build(b: *std.Build) !void {
+    const msvc_runtime = b.option(MsvcRuntime, "msvc-runtime", "The MSVC C runtime to compile for: static (/MT) or dll (/MD)") orelse .static;
@@ -123,0 +126,27 @@ pub fn build(b: *std.Build) !void {
+    if (target.result.abi == .msvc) {
+        try flags.append(b.allocator, if (msvc_runtime == .dll) "-fms-runtime-lib=dll" else "-fms-runtime-lib=static");
+    }
+
+    // Upstream disables autolink on the SIMD objects. Compile a metadata-only
+    // witness with the SAME flags, enabling autolink only for its pragma. It
+    // derives the stamp from compiler macros, not the requested option.
+    if (target.result.abi == .msvc) {
+        const witness = b.addWriteFiles().add("ghosttea-msvc-highway.cpp",
+            \\#ifndef _MT
+            \\#error MSVC runtime selection did not define _MT
+            \\#endif
+            \\#ifdef _DEBUG
+            \\#error Ghosttea release artifacts must not use a debug CRT
+            \\#endif
+            \\#ifdef _DLL
+            \\#pragma detect_mismatch("RuntimeLibrary", "MD_DynamicRelease")
+            \\#else
+            \\#pragma detect_mismatch("RuntimeLibrary", "MT_StaticRelease")
+            \\#endif
+        );
+        const witness_flags = try b.allocator.alloc([]const u8, flags.items.len + 1);
+        @memcpy(witness_flags[0..flags.items.len], flags.items);
+        witness_flags[flags.items.len] = "-fautolink";
+        lib.root_module.addCSourceFile(.{ .file = witness, .flags = witness_flags });
+    }
+
