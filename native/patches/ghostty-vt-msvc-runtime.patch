diff --git a/src/build/Config.zig b/src/build/Config.zig
index 24157293b5cb349d519b06f09616c99edd6adc20..50824d2cd48a97542ae90281267d1c82c5c6549a 100644
--- a/src/build/Config.zig
+++ b/src/build/Config.zig
@@ -50,0 +51 @@ strip: bool = false,
+msvc_runtime: MsvcRuntime = .static,
@@ -433,0 +435,6 @@ pub fn init(b: *std.Build, appVersion: []const u8, libVersion: []const u8) !Conf
+    config.msvc_runtime = b.option(
+        MsvcRuntime,
+        "msvc-runtime",
+        "The MSVC C runtime that C and C++ objects are compiled for: static (/MT) or dll (/MD). Only msvc targets read it.",
+    ) orelse .static;
+
@@ -877,0 +885,16 @@ pub const ExeEntrypoint = enum {
+/// The MSVC C runtime that C and C++ objects are compiled for. Every
+/// object in one link must agree: Rust links `dll` (/MD) unless its
+/// target enables `crt-static`.
+pub const MsvcRuntime = enum {
+    static,
+    dll,
+
+    pub fn cFlags(self: MsvcRuntime, target: std.Target) []const []const u8 {
+        if (target.abi != .msvc) return &.{};
+        return switch (self) {
+            .static => &.{},
+            .dll => &.{"-fms-runtime-lib=dll"},
+        };
+    }
+};
+
