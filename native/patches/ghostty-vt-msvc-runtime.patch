diff --git a/src/build/Config.zig b/src/build/Config.zig
index 0a99473174e27262f04169d0e765f2d2b85d53b7..daebee669875580a82e9c3f370e3ed6edebf694f 100644
--- a/src/build/Config.zig
+++ b/src/build/Config.zig
@@ -45,0 +46 @@ strip: bool = false,
+msvc_runtime: MsvcRuntime = .static,
@@ -339,0 +341,6 @@ pub fn init(b: *std.Build, appVersion: []const u8, libVersion: []const u8) !Conf
+    config.msvc_runtime = b.option(
+        MsvcRuntime,
+        "msvc-runtime",
+        "The MSVC C runtime that C and C++ objects are compiled for: static (/MT) or dll (/MD). Only msvc targets read it.",
+    ) orelse .static;
+
@@ -692,0 +700,19 @@ pub const ExeEntrypoint = enum {
+/// The MSVC C runtime that C and C++ objects are compiled for, named as
+/// `-fms-runtime-lib` names it. Every object in one link must agree, and the
+/// consumer of a static library decides: a Rust target links `dll` (/MD)
+/// unless it enables `crt-static`.
+pub const MsvcRuntime = enum {
+    static,
+    dll,
+
+    /// The compiler flags that select this runtime. `static` is clang's own
+    /// default for msvc targets, so it adds none and leaves objects as they were.
+    pub fn cFlags(self: MsvcRuntime, target: std.Target) []const []const u8 {
+        if (target.abi != .msvc) return &.{};
+        return switch (self) {
+            .static => &.{},
+            .dll => &.{"-fms-runtime-lib=dll"},
+        };
+    }
+};
+
