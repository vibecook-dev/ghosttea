+test "Terminal vt restores DECCOLM before custom tabstops" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    var builder: std.Io.Writer.Allocating = .init(alloc);
+    defer builder.deinit();
+
+    var source = try Terminal.init(testing.io, alloc, .{ .cols = 80, .rows = 6 });
+    defer source.deinit(alloc);
+    var source_stream = source.vtStream();
+    defer source_stream.deinit();
+    source_stream.nextSlice("\x1b[?40h\x1b[?3h\x1b[3g\x1b[6G\x1bH\x1b[H");
+    try testing.expect(source.modes.get(.enable_mode_3));
+    try testing.expect(source.modes.get(.@"132_column"));
+    try testing.expectEqual(@as(size.CellCountInt, 132), source.cols);
+
+    var formatter: TerminalFormatter = .init(&source, .vt);
+    formatter.content = .none;
+    formatter.extra = .none;
+    formatter.extra.modes = true;
+    formatter.extra.tabstops = true;
+    try formatter.format(&builder.writer);
+
+    var replacement = try Terminal.init(testing.io, alloc, .{ .cols = 80, .rows = 6 });
+    defer replacement.deinit(alloc);
+    var replacement_stream = replacement.vtStream();
+    defer replacement_stream.deinit();
+    replacement_stream.nextSlice(builder.writer.buffered());
+
+    try testing.expect(replacement.modes.get(.enable_mode_3));
+    try testing.expect(replacement.modes.get(.@"132_column"));
+    try testing.expectEqual(source.cols, replacement.cols);
+    try testing.expect(replacement.tabstops.get(5));
+    try testing.expect(!replacement.tabstops.get(8));
+}
