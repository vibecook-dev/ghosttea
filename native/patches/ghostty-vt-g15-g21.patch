+    inline for (@typeInfo(ScreenState).@"struct".field_names[1..]) |name| {
+        if (lib.sizedFieldFits(ScreenState, out.size, name)) {
+            @field(out, name) = @field(state, name);
+        }
+    }
+    return .success;
+}
+
+pub fn screen_grid_ref(
+    terminal_: Terminal,
+    screen_: lib.CEnum(TerminalScreen),
+    pt: point.Point.C,
+    out_ref: ?*grid_ref_c.CGridRef,
+) callconv(lib.calling_conv) Result {
+    if (comptime !(lib.feature(.grid_introspection) or lib.feature(.selection))) return .unsupported;
+    const t: *ZigTerminal = (terminal_ orelse return .invalid_value).terminal;
+    const key = lib.enumFromC(TerminalScreen, screen_) orelse return .invalid_value;
+    const zig_pt = point.Point.fromC(pt) orelse return .invalid_value;
+    const screen = t.screens.get(key) orelse return .no_value;
+    const p = screen.pages.pin(zig_pt) orelse return .invalid_value;
+    if (out_ref) |out| out.* = grid_ref_c.CGridRef.fromPin(p);
+    return .success;
+}
+
+pub fn screen_row_iterator_new(
+    alloc_: ?*const CAllocator,
+    terminal_: Terminal,
+    screen_: lib.CEnum(TerminalScreen),
+    out_: ?*ScreenRowIterator,
+) callconv(lib.calling_conv) Result {
+    if (comptime !lib.feature(.grid_introspection)) {
+        if (out_) |o| o.* = null;
+        return .unsupported;
+    }
+    const out = out_ orelse return .invalid_value;
+    out.* = null;
+
+    const t: *ZigTerminal = (terminal_ orelse return .invalid_value).terminal;
+    const key = lib.enumFromC(TerminalScreen, screen_) orelse return .invalid_value;
+    const screen = t.screens.get(key) orelse return .no_value;
+
+    const alloc = lib.alloc.default(alloc_);
+    const ptr = alloc.create(ScreenRowIteratorWrapper) catch
+        return .out_of_memory;
+    ptr.* = .{
+        .alloc = alloc,
+        .rows = screen.pages.rowIterator(
+            .right_down,
+            .{ .screen = .{} },
+            null,
+        ),
+    };
+
+    out.* = ptr;
+    return .success;
+}
+
+pub fn screen_row_iterator_free(
+    iterator_: ScreenRowIterator,
+) callconv(lib.calling_conv) void {
+    if (comptime !lib.feature(.grid_introspection)) return;
+    const iterator = iterator_ orelse return;
+    const alloc = iterator.alloc;
+    alloc.destroy(iterator);
+}
+
+pub fn screen_row_iterator_next(
+    iterator_: ScreenRowIterator,
+    out_ref_: ?*grid_ref_c.CGridRef,
+    out_has_value_: ?*bool,
+) callconv(lib.calling_conv) Result {
+    if (comptime !lib.feature(.grid_introspection)) return .unsupported;
+    const iterator = iterator_ orelse return .invalid_value;
+    const out_ref = out_ref_ orelse return .invalid_value;
+    const out_has_value = out_has_value_ orelse return .invalid_value;
+
+    const pin = iterator.rows.next() orelse {
+        out_ref.* = .{};
+        out_has_value.* = false;
+        return .success;
+    };
+
+    out_ref.* = .fromPin(pin);
+    out_has_value.* = true;
+    return .success;
+}
+
+pub fn screen_cursor_hyperlink(
+    terminal_: Terminal,
+    screen_: lib.CEnum(TerminalScreen),
+    uri_buf_: ?[*]u8,
+    uri_buf_len: usize,
+    out_uri_written_: ?*usize,
+    id_buf_: ?[*]u8,
+    id_buf_len: usize,
+    out_id_written_: ?*usize,
+    out_identity_: ?*grid_ref_c.HyperlinkIdentity,
+) callconv(lib.calling_conv) Result {
+    const t: *ZigTerminal = (terminal_ orelse return .invalid_value).terminal;
+    const out_uri_written = out_uri_written_ orelse return .invalid_value;
+    const out_id_written = out_id_written_ orelse return .invalid_value;
+    const out_identity = out_identity_ orelse return .invalid_value;
+    if (!lib.sizedCheck(.output, out_identity)) return .invalid_value;
+    const key = lib.enumFromC(TerminalScreen, screen_) orelse return .invalid_value;
+    const screen = t.screens.get(key) orelse return .no_value;
+    const link = screen.cursor.hyperlink orelse return .no_value;
+
+    const uri = link.uri;
+    const id: []const u8 = switch (link.id) {
+        .explicit => |bytes| bytes,
+        .implicit => "",
+    };
+    const identity: grid_ref_c.HyperlinkIdentity = switch (link.id) {
+        .explicit => .{ .tag = .explicit },
+        .implicit => |token| .{ .tag = .implicit, .implicit_token = token },
+    };
+
+    // Both sizes and the identity are written before the buffers are
+    // checked, so a size query also reports them.
+    out_uri_written.* = uri.len;
+    out_id_written.* = id.len;
+    lib.sizedWrite(out_identity, identity);
+
+    if ((uri.len != 0 and (uri_buf_ == null or uri_buf_len < uri.len)) or
+        (id.len != 0 and (id_buf_ == null or id_buf_len < id.len)))
+        return .out_of_space;
+
+    if (uri.len != 0) @memcpy(uri_buf_.?[0..uri.len], uri);
+    if (id.len != 0) @memcpy(id_buf_.?[0..id.len], id);
+    return .success;
+}
