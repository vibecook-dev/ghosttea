+    if (comptime !lib.feature(.grid_introspection)) return .unsupported;
+    const ref = ref_ orelse return .invalid_value;
+    const out_written = out_written_ orelse return .invalid_value;
+    const out_identity = out_identity_ orelse return .invalid_value;
+    if (!lib.sizedCheck(.output, out_identity)) return .invalid_value;
+    const p = ref.toPin() orelse return .invalid_value;
+
+    // The identity is written before the buffer is checked, so a size
+    // query also reports the tag and the implicit token.
+    out_written.* = 0;
+    lib.sizedWrite(out_identity, .{});
+
+    const terminal_page = p.node.page();
+    const cell = terminal_page.getRowAndCell(p.x, p.y).cell;
+    if (!cell.hyperlink) return .success;
+
+    const link_id = terminal_page.lookupHyperlink(cell) orelse return .success;
+    const entry = terminal_page.hyperlink_set.get(
+        terminal_page.memory,
+        link_id,
+    );
+    switch (entry.id) {
+        .implicit => |token| lib.sizedWrite(out_identity, .{
+            .tag = .implicit,
+            .implicit_token = token,
+        }),
+        .explicit => |slice| {
+            lib.sizedWrite(out_identity, .{ .tag = .explicit });
+
+            const id = slice.slice(terminal_page.memory);
+            if (id.len == 0) return .success;
+            if (buf_ == null or buf_len < id.len) {
+                out_written.* = id.len;
+                return .out_of_space;
+            }
+
+            @memcpy(buf_.?[0..id.len], id);
+            out_written.* = id.len;
+        },
+    }
+
+    return .success;
+}
