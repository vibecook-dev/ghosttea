@@ -237,0 +238,32 @@ GHOSTTY_API GhosttyResult ghostty_formatter_terminal_new(
+
+/**
+ * Create a formatter that emits terminal state without screen content.
+ *
+ * This is the state-only counterpart to ghostty_formatter_terminal_new().
+ * It formats no screen content. With GHOSTTY_FORMATTER_FORMAT_VT it writes
+ * only the sequences that GHOSTTY_FORMATTER_OPT_EXTRAS selects, which
+ * restore the terminal's state in another terminal. One of them prints:
+ * GHOSTTY_FORMATTER_EXTRA_CURSOR restores a pending wrap by writing the
+ * cell under the cursor again, or a space that it then erases. Plain text
+ * output is empty, and HTML output is at most the palette's style block.
+ *
+ * The new formatter starts with the default for every option, as listed on
+ * GhosttyFormatterOption, and they are changed with ghostty_formatter_set().
+ * A state formatter has no content to select, so setting
+ * GHOSTTY_FORMATTER_OPT_SELECTION to a selection returns
+ * GHOSTTY_INVALID_VALUE and reading it returns GHOSTTY_NO_VALUE.
+ *
+ * The terminal must outlive the formatter.
+ *
+ * @param allocator Pointer to allocator, or NULL to use the default allocator
+ * @param formatter Pointer to store the created formatter handle (NULL
+ *                  returns GHOSTTY_INVALID_VALUE)
+ * @param terminal The terminal to format (NULL returns GHOSTTY_INVALID_VALUE)
+ * @return GHOSTTY_SUCCESS on success, or an error code on failure
+ *
+ * @ingroup formatter
+ */
+GHOSTTY_API GhosttyResult ghostty_formatter_terminal_state_new(
+    const GhosttyAllocator* allocator,
+    GhosttyFormatter* formatter,
+    GhosttyTerminal terminal);
