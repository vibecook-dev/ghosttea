+pub fn grid_ref_hyperlink_identity(
+    ref_: ?*const CGridRef,
+    buf_: ?[*]u8,
+    buf_len: usize,
+    out_written_: ?*usize,
+    out_identity_: ?*HyperlinkIdentity,
